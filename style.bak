@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');
:root{--bg:#121013;--panel:#1a171b;--ink:#f6f0f2;--muted:#aaa0a6;--pink:#e7b1c3;--lilac:#c6b1c8;--cream:#e9ded9;--line:rgba(255,255,255,.12);--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);overflow-x:hidden}body.intro-active{overflow:hidden}img,video{display:block;width:100%}a{text-decoration:none;color:inherit}button{font:inherit}.reveal{opacity:0;transform:translateY(30px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1)}.reveal.visible{opacity:1;transform:none}.eyebrow{font-size:.64rem;letter-spacing:.25em;font-weight:600;margin:0 0 1rem;color:var(--pink)}h1,h2,h3,p{margin-top:0}h1,h2{font-weight:500;letter-spacing:-.055em}h1 em,h2 em{font-family:var(--serif);font-weight:500}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;background:var(--pink);color:#181318;padding:1rem 1.2rem;font-size:.66rem;font-weight:700;letter-spacing:.12em;transition:.25s}.button:hover{transform:translateY(-3px);background:#f0bfd0}.button-light{background:var(--cream)}.button-dark{background:var(--pink)}
/* cinematic opening */.intro{position:fixed;inset:0;z-index:100;background:#0d0b0f;display:grid;place-items:center;overflow:hidden;transition:opacity .75s ease,visibility .75s ease}.intro.exit{opacity:0;visibility:hidden;pointer-events:none}.intro-art{position:absolute;inset:0;display:grid;place-items:center}.intro-art img{height:100%;max-height:100%;object-fit:contain;object-position:center center;filter:grayscale(.55) contrast(1.04) brightness(.55);transform:scale(1.06);animation:introZoom 4s cubic-bezier(.16,1,.3,1) both}.intro-wash{position:absolute;inset:0;background:radial-gradient(circle at 50% 44%,transparent 0 16%,rgba(13,11,15,.18) 38%,rgba(13,11,15,.86) 100%),linear-gradient(180deg,rgba(8,7,9,.3),rgba(8,7,9,.15) 45%,rgba(8,7,9,.88))}.intro-grid{position:absolute;inset:0;opacity:.14;background:linear-gradient(90deg,transparent 49.9%,#fff 50%,transparent 50.1%),linear-gradient(0deg,transparent 49.9%,#fff 50%,transparent 50.1%);background-size:33.333% 100%,100% 33.333%;mask-image:radial-gradient(circle,black,transparent 72%)}.intro-content{position:relative;z-index:2;width:min(92vw,1200px);height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(1.3rem,4vw,3.5rem) 0 clamp(1.5rem,4vw,3rem)}.intro-kicker{font-size:.58rem;letter-spacing:.3em;color:#eee5e9}.intro-logo{font-size:clamp(4rem,13vw,11rem);font-weight:600;letter-spacing:-.09em;line-height:.72;align-self:center;text-shadow:0 20px 70px #000}.intro-logo em{display:block;font-family:var(--serif);font-weight:500;font-size:.45em;letter-spacing:-.04em;text-align:center;margin-top:.25em}.intro-line{display:grid;grid-template-columns:1fr 80px 1fr;align-items:center;gap:1rem;font-size:.54rem;letter-spacing:.2em;color:#ddd3d7}.intro-line span:last-child{text-align:right}.intro-line i{height:1px;background:rgba(255,255,255,.45)}.intro-loader{position:absolute;z-index:3;left:0;bottom:0;width:100%;height:2px;background:rgba(255,255,255,.12)}.intro-loader span{display:block;width:100%;height:100%;background:var(--pink);transform-origin:left;animation:load 2.2s cubic-bezier(.16,1,.3,1) both}@keyframes load{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes introZoom{from{transform:scale(1.13)}to{transform:scale(1.06)}}
/* header */.site-header{position:fixed;z-index:40;top:0;left:0;right:0;height:78px;padding:0 clamp(1.2rem,4vw,4rem);display:flex;align-items:center;justify-content:space-between;transition:.3s}.site-header.scrolled{background:rgba(18,16,19,.86);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:-.05em;font-size:1.1rem}.brand span{font-family:var(--serif);font-style:italic;font-weight:500;margin-left:.2rem}.site-header nav{display:flex;gap:2rem;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase}.site-header nav a{opacity:.75}.site-header nav a:hover{opacity:1;color:var(--pink)}.menu-btn,.mobile-menu{display:none}
/* hero */.hero{min-height:100svh;padding:130px clamp(1.2rem,5vw,6rem) 70px;display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(2rem,7vw,8rem);align-items:center;background:radial-gradient(circle at 15% 70%,#2b2029 0,transparent 34%),var(--bg)}.hero-copy{max-width:580px}.hero-copy h1{font-size:clamp(4.5rem,9vw,9rem);line-height:.83;margin:0 0 2rem}.hero-copy>p:not(.eyebrow){color:var(--muted);line-height:1.7;max-width:440px;margin-bottom:2rem}.hero-image{position:relative;height:min(82svh,850px);background:#272229;overflow:hidden}.hero-image img{height:100%;object-fit:contain}.hero-image span{position:absolute;right:1rem;bottom:1rem;padding:.55rem .7rem;background:rgba(18,16,19,.78);font-size:.55rem;letter-spacing:.16em}
/* manifesto */.manifesto{padding:clamp(6rem,11vw,12rem) clamp(1.2rem,6vw,7rem);display:grid;grid-template-columns:70px .9fr 1.25fr;gap:clamp(1.5rem,5vw,6rem);align-items:center;background:#211c22}.section-index{font-size:.65rem;letter-spacing:.2em;color:var(--pink);align-self:start}.manifesto-copy h2{font-size:clamp(3rem,6vw,6rem);line-height:.88;margin:0 0 2rem}.manifesto-copy>p:not(.eyebrow){max-width:470px;color:#b8adb4;line-height:1.75}.manifesto-images{display:grid;grid-template-columns:1.05fr .78fr;gap:1rem;align-items:end}.manifesto-images img{height:clamp(400px,60vw,700px);object-fit:contain;background:#2c262e}.manifesto-images img+img{height:clamp(300px,46vw,530px)}
/* videos */.editorial-stage{padding:clamp(6rem,10vw,11rem) clamp(1.2rem,5vw,6rem);background:#e0d2da;color:#201a21}.stage-intro{display:grid;grid-template-columns:1fr .75fr;gap:3rem;align-items:end;margin-bottom:3rem}.stage-intro h2{font-size:clamp(3.5rem,7vw,7rem);line-height:.84;margin:0}.stage-intro>p:last-child{max-width:320px;color:#625962;line-height:1.7;margin:0}.video-pair{display:grid;grid-template-columns:1.28fr .72fr;gap:1rem;align-items:end;max-width:1200px;margin:auto}.video-card{position:relative;overflow:hidden;background:#171419}.video-card video{width:100%;height:100%;object-fit:cover;object-position:center}.video-card-main{aspect-ratio:9/13}.video-card-small{aspect-ratio:9/12}.video-card-small video{filter:saturate(.88)}.video-caption{position:absolute;left:0;right:0;bottom:0;padding:1rem;display:flex;justify-content:space-between;align-items:end;background:linear-gradient(transparent,rgba(10,8,11,.8));font-size:.52rem;letter-spacing:.15em}.video-caption b{font-weight:500}.feature{padding:clamp(6rem,10vw,11rem) clamp(1.2rem,6vw,7rem);display:grid;grid-template-columns:1.1fr .8fr;gap:clamp(2rem,7vw,8rem);align-items:center;background:#2a242c}.feature-image{height:min(80vh,760px);background:#342e36}.feature-image img{height:100%;object-fit:contain}.feature-copy{max-width:520px}.feature-copy h2{font-size:clamp(3.2rem,6vw,6rem);line-height:.86}.feature-copy>p:not(.eyebrow){color:#bcb1b8;line-height:1.75}
/* collection */.collection{padding:clamp(6rem,10vw,11rem) clamp(1.2rem,5vw,6rem);background:#121013}.collection-head{display:flex;justify-content:space-between;gap:3rem;align-items:end;margin-bottom:2.5rem}.collection-head h2{font-size:clamp(3.2rem,6vw,6rem);line-height:.86;margin:0}.collection-head>p{max-width:360px;color:var(--muted);line-height:1.7;margin:0}.filters{display:flex;gap:.5rem;overflow:auto;padding-bottom:1rem;margin-bottom:2rem;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}.filter{border:1px solid var(--line);background:transparent;color:#cfc4ca;padding:.72rem .95rem;white-space:nowrap;font-size:.59rem;letter-spacing:.12em;cursor:pointer}.filter.active,.filter:hover{background:var(--pink);color:#171318;border-color:var(--pink)}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.product{background:#1b181d;border:1px solid rgba(255,255,255,.08);cursor:pointer;min-width:0;transition:.3s}.product:hover{transform:translateY(-5px);border-color:rgba(231,177,195,.4)}.product-media{aspect-ratio:4/5;background:#29242b;overflow:hidden}.product-media img{height:100%;object-fit:contain;padding:2%;transition:.55s}.product:hover .product-media img{transform:scale(1.03)}.product-info{padding:1rem}.product-name{font-size:.8rem;font-weight:600;color:#fff;line-height:1.3;margin-bottom:.55rem}.product-meta{display:flex;justify-content:space-between;color:#9f949b;font-size:.57rem;letter-spacing:.05em}.product-meta span:last-child{color:var(--pink)}
/* lookbook */.lookbook{padding:clamp(6rem,10vw,11rem) clamp(1.2rem,5vw,6rem);background:#201b22}.lookbook-head h2{font-size:clamp(3.5rem,7vw,7rem);line-height:.8;margin:0 0 3rem}.look-grid{display:grid;grid-template-columns:1.15fr .8fr .8fr;gap:1rem;align-items:end}.look-grid figure{position:relative;margin:0;background:#2d2730;overflow:hidden}.look-grid figure img{height:clamp(380px,60vw,720px);object-fit:contain}.look-grid figure:not(.look-tall) img{height:clamp(290px,44vw,520px)}.look-grid span{position:absolute;left:1rem;bottom:1rem;background:#171419;padding:.45rem .6rem;font-size:.55rem}
/* cta/footer */.cta{padding:clamp(6rem,10vw,11rem) clamp(1.2rem,6vw,7rem);display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,7rem);align-items:center;background:linear-gradient(120deg,#d8c5d0,#8b708a);color:#201a21}.cta-image{height:min(72vh,660px);background:#c7b4c0}.cta-image img{height:100%;object-fit:contain}.cta-copy h2{font-size:clamp(3.2rem,6vw,6rem);line-height:.86}.cta-copy>p:not(.eyebrow){color:#504750;line-height:1.7}.cta-copy .eyebrow{color:#5c4355}footer{padding:4rem clamp(1.2rem,5vw,6rem) 2rem;background:#0d0b0f;color:#aaa0a6;display:grid;grid-template-columns:2fr 1fr 1fr;gap:2rem}.footer-brand{font-size:clamp(3rem,7vw,7rem);letter-spacing:-.08em;color:#f5eef1}.footer-brand span{font-family:var(--serif);font-style:italic}.footer-links{display:flex;flex-direction:column;gap:.7rem}.footer-links a:hover{color:var(--pink)}.footer-bottom{grid-column:1/-1;border-top:1px solid var(--line);padding-top:1rem;margin-top:2rem;display:flex;justify-content:space-between;font-size:.57rem;letter-spacing:.1em}
/* modal */.product-modal{position:fixed;inset:0;z-index:90;display:none;align-items:center;justify-content:center;padding:1rem}.product-modal.open{display:flex}.modal-backdrop{position:absolute;inset:0;background:rgba(5,4,6,.78);backdrop-filter:blur(8px)}.modal-card{position:relative;z-index:1;width:min(900px,100%);display:grid;grid-template-columns:1fr .8fr;background:#211d23;border:1px solid var(--line);box-shadow:0 30px 100px #0008}.modal-close{position:absolute;right:.7rem;top:.7rem;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#f4edf0;color:#171318;font-size:1.5rem;cursor:pointer}.modal-image{background:#2c2630;min-height:500px}.modal-image img{height:100%;object-fit:contain}.modal-info{padding:clamp(1.5rem,4vw,3rem);display:flex;flex-direction:column;justify-content:center}.modal-info>span{font-size:.6rem;letter-spacing:.18em;color:var(--pink);text-transform:uppercase}.modal-info h3{font-size:clamp(2rem,4vw,3.5rem);line-height:.95;margin:1rem 0}.modal-info p{color:var(--muted);line-height:1.7}
/* responsive */@media(max-width:900px){.site-header nav{display:none}.menu-btn{display:flex;width:42px;height:42px;border:1px solid var(--line);background:rgba(20,17,21,.65);align-items:center;justify-content:center;flex-direction:column;gap:5px;cursor:pointer}.menu-btn i{width:16px;height:1px;background:#fff}.mobile-menu{position:fixed;z-index:39;top:76px;left:1rem;right:1rem;display:flex;flex-direction:column;background:rgba(23,20,25,.96);backdrop-filter:blur(16px);border:1px solid var(--line);transform:translateY(-15px);opacity:0;pointer-events:none;transition:.3s}.mobile-menu.open{transform:none;opacity:1;pointer-events:auto}.mobile-menu a{padding:1rem;border-bottom:1px solid var(--line);font-size:.72rem;letter-spacing:.12em}.hero{grid-template-columns:1fr;gap:2.5rem;padding-top:105px}.hero-image{height:70svh;min-height:480px}.manifesto{grid-template-columns:1fr}.section-index{display:none}.manifesto-images{max-width:700px}.stage-intro{grid-template-columns:1fr}.video-pair{grid-template-columns:1fr .68fr}.feature{grid-template-columns:1fr}.feature-image{height:70svh}.products{grid-template-columns:repeat(3,minmax(0,1fr))}.modal-card{grid-template-columns:1fr}.modal-image{height:55vh;min-height:350px}footer{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.intro-art img{object-position:center 35%;filter:grayscale(.5) brightness(.5);transform:scale(1.12);animation:introZoomMobile 3.5s cubic-bezier(.16,1,.3,1) both}.intro-logo{font-size:clamp(4.2rem,20vw,7rem)}.intro-line{grid-template-columns:1fr 38px 1fr;font-size:.43rem}.intro-content{padding:1.1rem 1rem 1.2rem}.site-header{height:64px}.mobile-menu{top:64px}.hero{padding:95px 1rem 3rem}.hero-copy h1{font-size:clamp(4rem,18vw,5.2rem)}.hero-image{height:68svh;min-height:440px}.manifesto,.editorial-stage,.feature,.collection,.lookbook,.cta{padding-left:1rem;padding-right:1rem}.manifesto-images{grid-template-columns:1fr 1fr;gap:.6rem}.manifesto-images img{height:420px}.manifesto-images img+img{height:320px}.stage-intro{gap:1.5rem;margin-bottom:1.5rem}.stage-intro h2{font-size:clamp(3.1rem,15vw,4.3rem)}.stage-intro>p:last-child{font-size:.88rem}.video-pair{grid-template-columns:1fr 1fr;gap:.6rem}.video-card-main,.video-card-small{aspect-ratio:9/15}.video-card video{object-fit:cover}.video-caption{display:block;padding:.7rem;font-size:.44rem}.video-caption b{display:block;margin-top:.35rem}.feature-image{height:68svh}.collection-head{display:block}.collection-head h2{font-size:clamp(3rem,14vw,4rem)}.collection-head>p{margin-top:1rem;font-size:.88rem}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.product-info{padding:.72rem}.product-name{font-size:.69rem}.product-meta{font-size:.49rem}.look-grid{grid-template-columns:1fr 1fr;gap:.6rem}.look-grid .look-tall{grid-column:1/-1}.look-grid figure img{height:65svh;min-height:370px}.look-grid figure:not(.look-tall) img{height:46svh;min-height:270px}.cta{grid-template-columns:1fr;gap:2rem}.cta-image{height:68svh}.footer-brand{font-size:3.2rem}footer{display:block;padding-top:3rem}.footer-links{margin-top:2rem}.footer-bottom{margin-top:2rem}.modal-image{height:52svh;min-height:320px}.modal-info h3{font-size:2.4rem}.modal-info .button{width:100%}}@keyframes introZoomMobile{from{transform:scale(1.18)}to{transform:scale(1.12)}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}

/* Final direction: image-only cinematic intro + sunrise reveal */
.intro{background:#08070a;transition:opacity 1.35s cubic-bezier(.16,1,.3,1),visibility 1.35s ease;}
.intro:after{content:"";position:absolute;inset:-20%;pointer-events:none;background:radial-gradient(circle at 50% 105%,rgba(241,204,190,.38),transparent 34%),radial-gradient(circle at 50% 55%,rgba(231,177,195,.08),transparent 42%);opacity:0;transition:opacity 1.35s ease;}
.intro.exit:after{opacity:1;}
.intro-art img{animation:introZoomLong 6s cubic-bezier(.12,.78,.18,1) both;filter:saturate(.82) contrast(1.05) brightness(.68);}
.intro-wash{background:radial-gradient(circle at 50% 44%,transparent 0 18%,rgba(13,11,15,.18) 38%,rgba(8,7,9,.82) 100%),linear-gradient(180deg,rgba(8,7,9,.18),rgba(8,7,9,.05) 48%,rgba(8,7,9,.9));}
.intro-logo{animation:introTextIn 1.4s .25s cubic-bezier(.16,1,.3,1) both;}
.intro-kicker,.intro-line{animation:introTextIn 1.1s .5s cubic-bezier(.16,1,.3,1) both;}
.intro-loader{height:1px;background:rgba(255,255,255,.12)}
.intro-loader span{animation:loadLong 6s cubic-bezier(.16,1,.3,1) both;}
body:not(.intro-active) main, body:not(.intro-active) .site-header, body:not(.intro-active) footer{animation:siteDawn 1.5s .12s cubic-bezier(.16,1,.3,1) both;}
.editorial-stage{background:linear-gradient(180deg,#ded0d8 0%,#eadde2 100%);}
.editorial-pair{display:grid;grid-template-columns:1.28fr .72fr;gap:1rem;align-items:end;max-width:1200px;margin:auto}
.editorial-card{position:relative;overflow:hidden;margin:0;background:#171419}
.editorial-card img{width:100%;height:100%;object-fit:contain;object-position:center;transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
.editorial-card:hover img{transform:scale(1.025)}
.editorial-card-main{aspect-ratio:9/13}.editorial-card-small{aspect-ratio:9/12}
.editorial-card figcaption{position:absolute;left:0;right:0;bottom:0;padding:1rem;display:flex;justify-content:space-between;align-items:end;color:#fff;background:linear-gradient(transparent,rgba(10,8,11,.82));font-size:.52rem;letter-spacing:.15em}
.editorial-card figcaption b{font-weight:500}
@keyframes introZoomLong{from{transform:scale(1.06)}to{transform:scale(1.01)}}
@keyframes loadLong{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes introTextIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes siteDawn{from{opacity:0;transform:translateY(20px);filter:brightness(.55)}35%{opacity:1;filter:brightness(.82)}to{opacity:1;transform:none;filter:brightness(1)}}
@media(max-width:600px){
 .intro-art img{object-position:center center;object-fit:contain;transform:scale(1.05);animation:introZoomLongMobile 6s cubic-bezier(.12,.78,.18,1) both;}
 .intro-logo{font-size:clamp(4.2rem,20vw,7rem)}
 .intro-line{grid-template-columns:1fr 38px 1fr;font-size:.43rem}
 .editorial-stage{padding-top:5.5rem;padding-bottom:5.5rem}
 .editorial-pair{grid-template-columns:1fr 1fr;gap:.6rem}
 .editorial-card-main,.editorial-card-small{aspect-ratio:9/14}
 .editorial-card figcaption{display:block;padding:.7rem;font-size:.44rem}
 .editorial-card figcaption b{display:block;margin-top:.35rem}
}
@keyframes introZoomLongMobile{from{transform:scale(1.08)}to{transform:scale(1.02)}}
